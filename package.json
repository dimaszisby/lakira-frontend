{
  "name": "lakira-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--inspect --trace-warnings' next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"src/**/*.{css,pcss}\"",
    "lint:css:fix": "stylelint \"src/**/*.{css,pcss}\" --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "build:css": "node node_modules/.bin/tailwindcss -i ./src/styles/globals.css -o ./src/styles/output.css",
    "next:cache:clear": "rm -rf .next && next clean",
    "check-accessibility": "npm install axe-core && echo 'Running accessibility checks with axe-core... (Placeholder)'",
    "test": "npm run test:unit",
    "test:unit": "jest --runInBand",
    "test:unit:watch": "jest --watch",
    "test:unit:ci": "jest --runInBand --coverage",
    "test:integration": "jest --runInBand --passWithNoTests --testPathPattern=\\.int\\.test\\.tsx?$",
    "test:e2e": "env -u ELECTRON_RUN_AS_NODE cypress run --e2e --browser electron --headless",
    "coverage:check": "node scripts/coverage-checklist.mjs",
    "security:lint": "npm run lint && npm run lint:css",
    "security:audit": "npm audit --audit-level=high",
    "security:scan": "npm run security:lint && npm run security:audit"
  },
  "dependencies": {
    "@ariakit/react": "^0.4.18",
    "@hookform/resolvers": "^4.1.3",
    "@tanstack/react-query": "^5.80.5",
    "@types/classnames": "^2.3.0",
    "axios": "^1.8.3",
    "axios-retry": "^4.5.0",
    "chart.js": "^4.4.8",
    "chartjs-adapter-date-fns": "^3.0.0",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.2.5",
    "framer-motion": "^12.5.0",
    "jotai": "^2.12.2",
    "next": "^16.0.3",
    "next-themes": "^0.4.6",
    "phosphor-react": "^1.4.1",
    "react": "19.2.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.54.2",
    "react-hot-toast": "^2.5.2",
    "react-use": "^17.6.0",
    "tailwind-merge": "^3.3.1",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "autoprefixer": "^10.4.17",
    "cypress": "^14.2.0",
    "eslint": "^9.36.0",
    "eslint-config-next": "^16.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^5.1.0",
    "eslint-plugin-cypress": "^5.2.0",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-jest-dom": "^5.5.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^6.1.0",
    "eslint-plugin-react-refresh": "^0.4.23",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sonarjs": "^3.0.5",
    "eslint-plugin-tailwindcss": "^3.18.2",
    "eslint-plugin-testing-library": "^7.11.0",
    "eslint-plugin-unused-imports": "^4.2.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-canvas-mock": "^2.5.2",
    "jest-environment-jsdom": "^29.7.0",
    "msw": "^2.12.2",
    "postcss": "^8.4.35",
    "postcss-import": "^16.1.1",
    "prettier": "^3.6.2",
    "stylelint": "^16.25.0",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-config-tailwindcss": "^0.0.7",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
