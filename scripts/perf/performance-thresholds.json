{
  "lighthouse": {
    "version": "12.8.2",
    "runsPerRoute": 3,
    "routes": ["/", "/login", "/register"],
    "categories": {
      "performance": 70,
      "accessibility": 90,
      "best-practices": 90
    }
  },
  "webVitals": {
    "lcpMs": 3600,
    "cls": 0.15,
    "inpMs": 300
  },
  "bundleSize": {
    "maxTotalJsBytes": 3000000,
    "maxLargestChunkBytes": 300000
  }
}
