# ---------------------------------------------------------------------------
# lakira-frontend — environment template
#
# Copy to .env.local and fill in. .env.local is gitignored; this file is not.
#
#   cp .env.example .env.local
#
# Canonical matrix: docs/reference/configuration.md
# Per-environment values: docs/reference/environments.md
#
# THE EXPOSURE RULE
# Anything prefixed NEXT_PUBLIC_ is inlined into the client bundle at build
# time and is readable by anyone who loads the page. It is not configuration;
# it is published content. Never put a token, key, secret, or internal
# hostname behind a NEXT_PUBLIC_ name — renaming it later does not un-publish
# the builds that already shipped.
# ---------------------------------------------------------------------------

# --- Backend API -----------------------------------------------------------

# Server-only. Base URL the proxy and the login route call.
# Read by src/app/api/proxy/[...path]/route.ts and src/app/api/auth/login/route.ts.
API_URL=http://localhost:4000/api/v1

# PUBLIC. Proxy fallback, and next.config.ts derives the CSP connect-src
# origin from it. Keep this EQUAL to API_URL within an environment.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# NOTE — three conflicting local defaults are in circulation and this file
# follows docs/reference/environments.md (:4000). The proxy's own hardcoded
# fallback is :8001, and the app itself serves on :3000. Confirm the port your
# backend actually listens on before trusting either. Do not add a fourth
# default. Tracked for resolution in the SaaS-readiness iteration plan.

# --- App origin ------------------------------------------------------------

# PUBLIC. First candidate for SSR origin resolution (src/services/api/api.ts).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PUBLIC. Second candidate. Optional — leave unset for local development.
# NEXT_PUBLIC_SITE_URL=

# On Vercel, NEXT_PUBLIC_VERCEL_URL and VERCEL_URL are injected by the
# platform and are used as the third and fourth candidates. Do not set them
# by hand. HOST and PORT are the final fallback, defaulting to localhost:3000.

# --- Feature flags ---------------------------------------------------------

# PUBLIC. Compared === "true". Gates the "generate dummy data" buttons.
NEXT_PUBLIC_ENABLE_DUMMY_ACTIONS=false

# --- Tooling (optional — only needed when running these scripts) -----------

# npm run api:spec:sync — where to pull the backend OpenAPI snapshot from.
# LAKIRA_OPENAPI_BRANCH=main
# LAKIRA_OPENAPI_URL=
# LAKIRA_BACKEND_PATH=../lakira-backend

# npm run perf:lighthouse — target origin.
# PERF_BASE_URL=http://127.0.0.1:3000

# npm run test:e2e — Cypress target origin.
# CYPRESS_BASE_URL=http://127.0.0.1:3000

# Cypress credentials are read via Cypress.env(), not process.env. Put them in
# a gitignored cypress.env.json, never here.
# E2E_USER_EMAIL=
# E2E_USER_PASSWORD=
